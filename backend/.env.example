# BioFit Backend — example environment variables
# Copy values into application-local.properties or your shell. Never commit real secrets.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# JWT (use a long random string in production)
BIOFIT_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
BIOFIT_JWT_ACCESS_MINUTES=30
BIOFIT_JWT_REFRESH_DAYS=7

# SQL Server profile (spring.profiles.active=sqlserver)
DATABASE_URL=jdbc:sqlserver://localhost;instanceName=SQLEXPRESS;databaseName=biofit;encrypt=true;trustServerCertificate=true
DATABASE_USERNAME=sa
DATABASE_PASSWORD=YourStrong!Passw0rd

# CORS (Vite default)
BIOFIT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
