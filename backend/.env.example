# BioFit Backend — example environment variables
# Copy this file to backend/.env and fill in real values. Never commit .env.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

BIOFIT_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
BIOFIT_JWT_ACCESS_MINUTES=30
BIOFIT_JWT_REFRESH_DAYS=7
BIOFIT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Email / OTP — Gmail SMTP
# Google Account → Security → 2-Step Verification → App passwords
# Use the 16-character App Password (NOT your normal Gmail password).
# ---------------------------------------------------------------------------
BIOFIT_MAIL_ENABLED=true
# Local only: when SMTP fails, return OTP in API/console. MUST be false in production.
BIOFIT_MAIL_DEV_FALLBACK=true

SPRING_MAIL_HOST=smtp.gmail.com
# Port 465 = SSL (recommended below). Port 587 = STARTTLS instead.
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=your.address@gmail.com
SPRING_MAIL_PASSWORD=your-16-char-app-password
BIOFIT_MAIL_FROM=your.address@gmail.com
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_SSL=true
SPRING_MAIL_SMTP_STARTTLS=false
SPRING_MAIL_SMTP_STARTTLS_REQUIRED=false
# For port 587 use instead:
# SPRING_MAIL_PORT=587
# SPRING_MAIL_SMTP_SSL=false
# SPRING_MAIL_SMTP_STARTTLS=true
# SPRING_MAIL_SMTP_STARTTLS_REQUIRED=true
