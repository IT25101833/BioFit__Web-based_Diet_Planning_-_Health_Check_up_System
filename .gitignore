# ##############################################################################
# BipFit Project Root .gitignore (Merged Backend & Frontend)
# ##############################################################################

# ==========================================
# OS & System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==========================================
# IDEs and Editors (VS Code, IntelliJ, Eclipse, NetBeans)
# ==========================================
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# ==========================================
# Java / Spring Boot Backend
# ==========================================
/backend/target/
/backend/build/
!/backend/**/src/main/**/target/
!/backend/**/src/test/**/target/
!/backend/**/src/main/**/build/
!/backend/**/src/test/**/build/
/backend/HELP.md

# ==========================================
# Node.js / React Frontend
# ==========================================
/frontend/node_modules/
/frontend/dist/
/frontend/dist-ssr/
/frontend/coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables & Local Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local
**/application-local.properties
backend/data/
